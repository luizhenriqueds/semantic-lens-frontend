# Copy to .env.local and fill in. Everything under "Required" must be set or the app will not
# start correctly - the NEXT_PUBLIC_ pair in particular is read by middleware, and without it
# authentication silently fails on every route.

# --- Required ---

# Same Supabase project, twice: the NEXT_PUBLIC_ pair is used by middleware and the browser
# client, the unprefixed pair by the server-side data layer.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings + reranker. /search returns nothing useful without it.
DEEPINFRA_API_KEY=

# --- Optional ---

# Used to build confirmation and password-reset links. Must match how you browse the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional e-mail (sign-up confirmation, password reset, magic link, welcome).
# Unset means those flows generate a link but never deliver it.
RESEND_API_KEY=
EMAIL_FROM=

# Hybrid keyword + vector retrieval. Off falls back to keyword-only search.
ENABLE_HYBRID_SEARCH=true

# Semantic cache. No-op when unset; SEMCACHE_SHADOW logs hit rates without serving.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
SEMCACHE_ENABLED=true
SEMCACHE_SHADOW=

# Rate limiting, per IP for anonymous traffic and per account once signed in. No-op when unset;
# RATELIMIT_SHADOW alone logs what it would have blocked without blocking anything.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATELIMIT_ENABLED=
RATELIMIT_SHADOW=true
RATELIMIT_TIMEOUT_MS=800

# Where the client address comes from. Empty auto-detects (x-vercel-forwarded-for, then
# x-forwarded-for). Set to cf-connecting-ip once the domain is proxied through Cloudflare.
RATELIMIT_CLIENT_IP_HEADER=
# Hops in front of the app, for the x-forwarded-for fallback. Set to 0 when nothing rewrites that
# header: it is client-supplied, so trusting it there makes per-IP limiting decorative.
RATELIMIT_TRUSTED_PROXIES=1

# Per-bucket overrides as limit/seconds, primary window first. Buckets: PAGE, SEARCH, EXPORT,
# IMAGE. Tiers: ANON, AUTHED, BASIC, INVESTOR, PROFESSIONAL, PLATFORM.
# RATELIMIT_PAGE_ANON=300/60,3000/3600
# RATELIMIT_SEARCH_ANON=8/60,60/3600
